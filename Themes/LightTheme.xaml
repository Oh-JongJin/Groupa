<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PopupBackground" Color="#E0F9F9F9" />
    <SolidColorBrush x:Key="PopupBorder" Color="#20000000" />
    <SolidColorBrush x:Key="HeaderForeground" Color="#DD000000" />
    <SolidColorBrush x:Key="ItemForeground" Color="#DD000000" />
    <SolidColorBrush x:Key="ItemHoverBackground" Color="#0A000000" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#12000000" />
    <SolidColorBrush x:Key="FooterItemForeground" Color="#DD000000" />

    <!-- Hover animation colors for light mode -->
    <Color x:Key="HoverColor">#0A000000</Color>
    <Color x:Key="TransparentColor">#00000000</Color>

    <!-- Editor window colors -->
    <SolidColorBrush x:Key="EditorWindowBg" Color="#F3F3F3" />
    <SolidColorBrush x:Key="EditorButtonBg" Color="#E5E5E5" />
    <SolidColorBrush x:Key="EditorButtonHover" Color="#D8D8D8" />
    <SolidColorBrush x:Key="EditorButtonPressed" Color="#CCCCCC" />
    <SolidColorBrush x:Key="EditorInputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="EditorBorderColor" Color="#CCCCCC" />
    <SolidColorBrush x:Key="EditorSelectedBg" Color="#D0E8FF" />

    <Style x:Key="MenuItemButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ItemForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ItemBorder" CornerRadius="4" Padding="12,8">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource TransparentColor}" />
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}" 
                                   Width="24" Height="24" Margin="0,0,12,0" />
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation To="{StaticResource HoverColor}" Duration="0:0:0.15" 
                                                    Storyboard.TargetName="ItemBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                        <ColorAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ColorAnimation.EasingFunction>
                                    </ColorAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation To="{StaticResource TransparentColor}" Duration="0:0:0.15" 
                                                    Storyboard.TargetName="ItemBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                        <ColorAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ColorAnimation.EasingFunction>
                                    </ColorAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FooterButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FooterItemForeground}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ItemBorder" CornerRadius="4" Padding="12,6">
                        <Border.Background>
                            <SolidColorBrush Color="{StaticResource TransparentColor}" />
                        </Border.Background>
                        <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation To="{StaticResource HoverColor}" Duration="0:0:0.15" 
                                                    Storyboard.TargetName="ItemBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                        <ColorAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ColorAnimation.EasingFunction>
                                    </ColorAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation To="{StaticResource TransparentColor}" Duration="0:0:0.15" 
                                                    Storyboard.TargetName="ItemBorder" 
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)">
                                        <ColorAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </ColorAnimation.EasingFunction>
                                    </ColorAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semibold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource HeaderForeground}" />
        <Setter Property="Margin" Value="16,12,16,8" />
    </Style>

    <Style x:Key="MenuSeparator" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource SeparatorBrush}" />
        <Setter Property="Margin" Value="12,4" />
    </Style>

</ResourceDictionary>
