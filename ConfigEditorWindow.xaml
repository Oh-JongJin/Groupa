<Window x:Class="JumpListLauncher.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:h="clr-namespace:JumpListLauncher.Helpers"
        x:Name="EditorWindow"
        Width="520" Height="580"
        MinWidth="400" MinHeight="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="ListBox" x:Key="EditorListBox">
            <Setter Property="Background" Value="{DynamicResource EditorInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ItemForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EditorBorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Group Selector -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="LblGroup" Text="Group" Foreground="{DynamicResource HeaderForeground}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,6"/>
            <DockPanel>
                <Button x:Name="BtnDeleteGroup" DockPanel.Dock="Right" Style="{StaticResource EditorButton}" Click="DeleteGroup_Click" Margin="8,0,0,0"/>
                <Button x:Name="BtnAddGroup" DockPanel.Dock="Right" Style="{StaticResource EditorButton}" Click="AddGroup_Click" Margin="8,0,0,0"/>
                <ComboBox x:Name="CmbGroup" FontSize="13" Height="30" VerticalContentAlignment="Center"
                          SelectionChanged="CmbGroup_SelectionChanged"
                          PreviewMouseWheel="CmbGroup_PreviewMouseWheel"/>
            </DockPanel>
        </StackPanel>

        <!-- Group Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="LblGroupName" Foreground="{DynamicResource HeaderForeground}" FontFamily="Segoe UI" FontSize="12" Margin="0,0,0,6"/>
            <TextBox x:Name="GroupNameBox" Style="{StaticResource EditorTextBox}" TextChanged="GroupNameBox_TextChanged"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock x:Name="TxtDropHint" DockPanel.Dock="Right" FontFamily="Segoe UI" FontSize="11"
                       Foreground="{DynamicResource EditorSecondaryText}" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="LblAppList" Foreground="{DynamicResource HeaderForeground}" FontFamily="Segoe UI" FontSize="12"/>
        </DockPanel>

        <Grid Grid.Row="3" Margin="0,0,0,12">
        <ListBox x:Name="AppListBox" Style="{StaticResource EditorListBox}"
                 SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AllowDrop="True"
                 MouseDoubleClick="AppListBox_MouseDoubleClick"
                 SelectionChanged="AppListBox_SelectionChanged"
                 PreviewKeyDown="AppListBox_PreviewKeyDown"
                 PreviewMouseLeftButtonDown="AppListBox_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="AppListBox_PreviewMouseMove"
                 DragEnter="AppListBox_DragOver"
                 DragOver="AppListBox_DragOver"
                 Drop="AppListBox_Drop"
                 DragLeave="AppListBox_DragLeave"
                 ContextMenuOpening="AppListBox_ContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu x:Name="ItemMenu">
                    <MenuItem x:Name="MnuRename" Click="RenameApp_Click" InputGestureText="F2" Icon="&#xE8AC;"/>
                    <MenuItem x:Name="MnuUp" Click="MoveUp_Click" InputGestureText="Alt+↑" Icon="&#xE74A;"/>
                    <MenuItem x:Name="MnuDown" Click="MoveDown_Click" InputGestureText="Alt+↓" Icon="&#xE74B;"/>
                    <Separator/>
                    <MenuItem x:Name="MnuRemove" Click="RemoveApp_Click" InputGestureText="Del" Icon="&#xE74D;"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="600">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                               Margin="0,0,10,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SecondaryText}" FontSize="11"
                                       Foreground="{DynamicResource EditorSecondaryText}"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SecondaryText}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource ItemForeground}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                        Margin="2,1" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="h:HoverHelper.Suppress" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorButtonBg}"/>
                                    </MultiTrigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource EditorSelectedBg}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <!-- Insertion line shown while dragging files over the list -->
        <Canvas IsHitTestVisible="False">
            <Rectangle x:Name="DropLine" Height="2" RadiusX="1" RadiusY="1"
                       Fill="{DynamicResource EditorAccent}" Visibility="Collapsed"/>
        </Canvas>
        </Grid>

        <!-- One row: Add (menu: app/file, folder, URL) on the left, actions for the selected item on the right.
             Reordering is by drag (or Alt+Up/Down / right-click menu). -->
        <DockPanel Grid.Row="4" Margin="0,0,0,16" LastChildFill="False">
            <Button x:Name="BtnAdd" DockPanel.Dock="Left" Style="{StaticResource EditorButton}" Click="AddMenu_Click">
                <Button.ContextMenu>
                    <ContextMenu x:Name="AddMenu" Placement="Top">
                        <MenuItem x:Name="MnuAddApp" Click="AddApp_Click" Icon="&#xE7AC;"/>
                        <MenuItem x:Name="MnuAddFolder" Click="AddFolder_Click" Icon="&#xE8B7;"/>
                        <MenuItem x:Name="MnuAddUrl" Click="AddUrl_Click" Icon="&#xE774;"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <Button x:Name="BtnRemove" DockPanel.Dock="Right" Style="{StaticResource EditorButton}" Click="RemoveApp_Click" Margin="8,0,0,0"/>
            <Button x:Name="BtnRename" DockPanel.Dock="Right" Style="{StaticResource EditorButton}" Click="RenameApp_Click"/>
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Style="{StaticResource EditorButton}" Click="Save_Click" Width="80" Margin="0,0,8,0"/>
            <Button x:Name="BtnCancel" Style="{StaticResource EditorButton}" Click="Cancel_Click" Width="80"/>
        </StackPanel>
    </Grid>
</Window>
