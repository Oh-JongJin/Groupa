<Window x:Class="JumpListLauncher.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="360" Height="240"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Theme -->
        <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LblTheme" Text="Theme"
                   VerticalAlignment="Center" FontSize="14"
                   Foreground="{DynamicResource ItemForeground}"/>
        <ComboBox Grid.Row="0" Grid.Column="2" x:Name="CmbTheme"
                  Height="30" FontSize="13" VerticalContentAlignment="Center"/>

        <!-- Language -->
        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LblLanguage" Text="Language"
                   VerticalAlignment="Center" FontSize="14"
                   Foreground="{DynamicResource ItemForeground}"/>
        <ComboBox Grid.Row="2" Grid.Column="2" x:Name="CmbLanguage"
                  Height="30" FontSize="13" VerticalContentAlignment="Center"/>

        <!-- Notice -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   x:Name="TxtNotice" Text=""
                   FontSize="11" Foreground="{DynamicResource HeaderForeground}"
                   TextWrapping="Wrap"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="Save" Width="80" Height="30"
                    Margin="0,0,8,0" Click="BtnSave_Click"
                    FontSize="13" Cursor="Hand"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="30"
                    Click="BtnCancel_Click"
                    FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
