<Window x:Class="JumpListLauncher.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <StackPanel Margin="24,20,24,20">
        <!-- Theme -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="LblTheme" Text="Theme"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource ItemForeground}"/>
            <ComboBox Grid.Column="2" x:Name="CmbTheme"
                      Height="30" FontSize="13" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Language -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="LblLanguage" Text="Language"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource ItemForeground}"/>
            <ComboBox Grid.Column="2" x:Name="CmbLanguage"
                      Height="30" FontSize="13" VerticalContentAlignment="Center"/>
        </Grid>

        <!-- Separator -->
        <Rectangle Height="1" Fill="{DynamicResource PopupBorder}" Margin="0,2,0,14"/>

        <!-- Hotkey Enabled -->
        <CheckBox x:Name="ChkHotkeyEnabled" Margin="0,0,0,10"
                  FontSize="13" VerticalContentAlignment="Center"
                  Foreground="{DynamicResource ItemForeground}"
                  Checked="ChkHotkeyEnabled_Changed" Unchecked="ChkHotkeyEnabled_Changed"/>

        <!-- Hotkey Input -->
        <Grid x:Name="HotkeyPanel" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="LblHotkey" Text="Hotkey"
                       VerticalAlignment="Center" FontSize="14"
                       Foreground="{DynamicResource ItemForeground}"/>
            <TextBox Grid.Column="2" x:Name="TxtHotkey"
                     Height="30" FontSize="13" IsReadOnly="True"
                     VerticalContentAlignment="Center" TextAlignment="Center"
                     Cursor="Hand" PreviewKeyDown="TxtHotkey_PreviewKeyDown"
                     GotFocus="TxtHotkey_GotFocus" LostFocus="TxtHotkey_LostFocus"/>
        </Grid>

        <!-- Notice -->
        <TextBlock x:Name="TxtNotice" Text=""
                   FontSize="11" Foreground="{DynamicResource HeaderForeground}"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="Save" Width="80" Height="30"
                    Margin="0,0,8,0" Click="BtnSave_Click"
                    FontSize="13" Cursor="Hand"/>
            <Button x:Name="BtnCancel" Content="Cancel" Width="80" Height="30"
                    Click="BtnCancel_Click"
                    FontSize="13" Cursor="Hand"/>
        </StackPanel>
    </StackPanel>
</Window>
