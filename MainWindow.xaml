<Window x:Class="JumpListLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JumpListLauncher"
        mc:Ignorable="d"
        WindowStyle="None"
        Background="#012C2C2C"
        ShowInTaskbar="True"
        ResizeMode="CanMinimize"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        Title="Groupa"
        MinWidth="280"
        MaxWidth="340">

    <Border x:Name="MainBorder" 
            CornerRadius="8" 
            Background="{DynamicResource PopupBackground}" 
            BorderBrush="{DynamicResource PopupBorder}" 
            BorderThickness="1" 
            Padding="4,4,4,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Row 0: Tab bar -->
                <RowDefinition Height="Auto"/>  <!-- Row 1: Header text -->
                <RowDefinition Height="Auto"/>  <!-- Row 2: Separator -->
                <RowDefinition Height="*"/>     <!-- Row 3: App list (fills remaining) -->
                <RowDefinition Height="Auto"/>  <!-- Row 4: Separator -->
                <RowDefinition Height="Auto"/>  <!-- Row 5: Footer buttons -->
            </Grid.RowDefinitions>

            <!-- Group Tab Bar (hidden when only 1 group) -->
            <ItemsControl x:Name="GroupTabs" Grid.Row="0" Margin="8,8,8,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="TabBorder" CornerRadius="4" Padding="10,4" Margin="2,0"
                                Cursor="Hand" 
                                Background="Transparent"
                                MouseLeftButtonDown="GroupTab_Click">
                            <TextBlock x:Name="TabText" Text="{Binding GroupName}" FontSize="12" FontFamily="Segoe UI"
                                       Foreground="{DynamicResource HeaderForeground}"/>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource TabSelectedBackground}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource TabSelectedBorder}"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource TabSelectedForeground}"/>
                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="HeaderText" Grid.Row="1" Style="{DynamicResource HeaderText}" />
            <Rectangle Grid.Row="2" Style="{DynamicResource MenuSeparator}" />
            
            <Grid Grid.Row="3">
                <ListBox x:Name="AppList"
                         Background="Transparent" BorderThickness="0"
                         Focusable="False"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="AppList_PreviewMouseDown"
                         PreviewMouseMove="AppList_PreviewMouseMove"
                         DragOver="AppList_DragOver"
                         DragLeave="AppList_DragLeave"
                         Drop="AppList_Drop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <!-- Keyboard focus goes to the item button itself (arrow-key navigation) -->
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Style="{DynamicResource MenuItemButton}" 
                                        Content="{Binding Name}" 
                                        Tag="{Binding Icon}" 
                                        Click="AppItem_Click"
                                        HorizontalContentAlignment="Left"/>
                                <Button x:Name="DeleteBtn"
                                        Content="✕" 
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"
                                        FontSize="12"
                                        Width="24" Height="24"
                                        Cursor="Hand"
                                        Opacity="0"
                                        Focusable="False"
                                        Click="DeleteItem_Click"
                                        Foreground="{DynamicResource HeaderForeground}"
                                        Background="Transparent"
                                        BorderThickness="0"/>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DeleteBtn" 
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="DeleteBtn" 
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Drop indicator line -->
                <Rectangle x:Name="DropIndicator"
                           Height="2"
                           Fill="{DynamicResource PopupBorder}"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Margin="12,0,12,0"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>

                <!-- Empty group guidance -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Margin="16,24" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{DynamicResource HeaderForeground}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button x:Name="BtnEmptyAdd" Style="{DynamicResource FooterButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="EmptyAdd_Click"/>
                </StackPanel>
            </Grid>

            <Rectangle Grid.Row="4" Style="{DynamicResource MenuSeparator}" />

            <!-- Footer: one row. No Close button: Esc, clicking outside or the taskbar button close the popup. -->
            <UniformGrid Grid.Row="5" Rows="1" Columns="2">
                <Button x:Name="BtnSettings" Style="{DynamicResource FooterButton}" Click="Settings_Click"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock x:Name="TxtSettings" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnPreferences" Style="{DynamicResource FooterButton}" Click="Preferences_Click"
                        HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,1,8,0"/>
                        <TextBlock x:Name="TxtPreferences" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Undo bar after quick-delete (✕). Overlays the footer so the app list layout never shifts. -->
            <Border x:Name="UndoBar" Grid.Row="4" Grid.RowSpan="2"
                    VerticalAlignment="Bottom" Margin="8,0,8,0"
                    CornerRadius="6" Padding="12,2,2,2"
                    Background="{DynamicResource EditorButtonBg}"
                    BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1"
                    Visibility="Collapsed">
                <DockPanel>
                    <Button x:Name="BtnUndo" DockPanel.Dock="Right"
                            Style="{DynamicResource FooterButton}" FontWeight="SemiBold"
                            Click="Undo_Click"/>
                    <TextBlock x:Name="UndoText" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="13"
                               Foreground="{DynamicResource ItemForeground}"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
